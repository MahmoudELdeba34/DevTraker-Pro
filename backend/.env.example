PORT=5000
MONGODB_URI=mongodb://localhost:27017/devtracker

# JWT_SECRET — MUST be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace_me_with_a_long_random_string_at_least_32_chars

# Frontend origin — used for account setup links and CORS
FRONTEND_URL=http://localhost:4200

# Production (MonsterASP): use your live URL
# FRONTEND_URL=https://siteXXXXX.monsterasp.net

# Optional extra CORS origins (comma-separated)
# CORS_ORIGINS=https://www.yourdomain.com

# WebAuthn / phone fingerprint (HTTPS required in production)
# WEBAUTHN_RP_NAME=DevTracker Pro
# WEBAUTHN_RP_ID=siteXXXXX.monsterasp.net
# WEBAUTHN_ORIGIN=https://siteXXXXX.monsterasp.net

# SMTP — OPTIONAL. If omitted, share setup links from the Members page instead.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASS=your_app_password
